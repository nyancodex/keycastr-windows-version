{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyCastr",
  "version": "0.2.1",
  "identifier": "com.keycastr.windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyNTA2MDc4NjlCQkMzRgpSV1Evdkp1R0J3WWxEMndOQzRHK2g2S1diNXByVFZTQUZMRXZ1eDdCL1dPSERHTWtzMWJhZVkrTAo=",
      "endpoints": [
        "https://github.com/nyancodex/keycastr-windows-version/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
